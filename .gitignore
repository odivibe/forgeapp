# forgeapp/.gitignore

# ── Dependencies ──────────────────────────────────────────────────
# Never commit these — they're large and reinstalled via npm install
node_modules/

# ── Environment files ─────────────────────────────────────────────
# These contain real secrets — passwords, JWT keys, API keys
# .env.example is the ONLY exception — it's a template with no real values
.env
.env.local
.env.development
.env.production
.env.*
!.env.example          # keep the example file — it has no real secrets

# ── Build output ──────────────────────────────────────────────────
# Generated by npm run build — not source code, don't commit it
dist/
build/
client/dist/

# ── Docker ────────────────────────────────────────────────────────
# Local Docker override files
docker-compose.override.yml

# ── Database ──────────────────────────────────────────────────────
# Never commit local database files
*.sql.bak
postgres_data/

# ── Logs ──────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*

# ── OS files ──────────────────────────────────────────────────────
# Mac
.DS_Store
.AppleDouble

# Windows
Thumbs.db
desktop.ini

# ── Editor ────────────────────────────────────────────────────────
.vscode/settings.json    # personal editor settings
.idea/                   # JetBrains IDEs
*.swp                    # Vim swap files

# ── Terraform (for later steps) ───────────────────────────────────
infrastructure/.terraform/
infrastructure/*.tfstate
infrastructure/*.tfstate.backup
infrastructure/*.tfvars
!infrastructure/*.tfvars.example